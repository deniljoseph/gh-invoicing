# Copy this to .env for local development
# Railway sets these automatically in production

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Optional: SQLite path (only used when DATABASE_URL is not set)
# SQLITE_PATH=geometry_home.db

# Daily backup to Google Drive via Apps Script web app (see README_BACKUP.md).
# Must equal TOKEN in the Apps Script. The Web app URL + on/off are set in Settings.
GDRIVE_WEBAPP_TOKEN=
